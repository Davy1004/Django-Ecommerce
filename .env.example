# copy to .env for local development (never commit .env)
DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
# leave empty for local SQLite, or e.g. postgres://user:pass@host:5432/dbname
DATABASE_URL=
# mock = no account needed | razorpay = Razorpay TEST keys
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PENDING_ORDER_TTL_MINUTES=30
# payment webhook pipeline: shared secret used to sign/verify webhooks (empty = webhook endpoint refuses everything)
WEBHOOK_SECRET=
EVENT_MAX_ATTEMPTS=5
EVENT_BACKOFF_SECONDS=5
# order emails: console backend prints them to the log; use SMTP for real delivery
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=ShopCraft <no-reply@example.com>
FRONTEND_URL=http://localhost:3000
# admin dashboard login, created/updated on every deploy by `manage.py ensure_admin` (skipped when empty)
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
