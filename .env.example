# copy to .env for local development (never commit .env)
DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
# leave empty for local SQLite, or e.g. postgres://user:pass@host:5432/dbname
DATABASE_URL=
# mock = no account needed | razorpay = Razorpay TEST keys
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PENDING_ORDER_TTL_MINUTES=30
# payment webhook pipeline: shared secret used to sign/verify webhooks (empty = webhook endpoint refuses everything)
WEBHOOK_SECRET=
EVENT_MAX_ATTEMPTS=5
EVENT_BACKOFF_SECONDS=5
